# Import python libraries
import os
from os.path import join
import itertools
import yaml
import pandas as pd

# Set directories
WORKDIR = config["workdir"]
RESULTSDIR = join(WORKDIR,"results")
SCRIPTSDIR = config["scriptsdir"]
RAWDIR = config["rawdir"]

# Get list of samples/libraries
manifest = pd.read_table(config["manifest"])
LIBRARIES =  manifest['Library'].unique()
LIBRARY_TO_FCIDS = manifest.groupby('Library')['FCID'].unique().to_dict()
print(LIBRARY_TO_FCIDS)
# Helper to flatten all (library, fcid) pairs
LIBRARY_FCID_PAIRS = [(lib, fcid) for lib in LIBRARIES for fcid in LIBRARY_TO_FCIDS[lib]]
print(LIBRARY_FCID_PAIRS)
HASHTAGS_PER_LIBRARY = manifest.groupby('Library')['Hashtag'].apply(lambda x: ",".join(sorted(x.dropna().unique()))).to_dict()

# Define tools
with open(config["tools"]) as f:
    TOOLS = yaml.safe_load(f)

# Define resources per rule
with open(config["cluster"]) as f:
    CLUSTER = yaml.safe_load(f)

getthreads=lambda rname:int(CLUSTER[rname]["threads"]) if rname in CLUSTER and "threads" in CLUSTER[rname] else int(CLUSTER["__default__"]["threads"])
getmemg=lambda rname:CLUSTER[rname]["mem"] if rname in CLUSTER and "mem" in CLUSTER[rname] else CLUSTER["__default__"]["mem"]

# Rules

localrules: link_fastq, make_multi_csv, copy_summary

rule all:
    input:
        # Link fastq: only valid (library, fcid) pairs, and all mode/read for each
        [
            join(RESULTSDIR, "raw", f"{lib}_{mode}_{fcid}_S1_L001_{read}_001.fastq.gz")
            for lib, fcid in LIBRARY_FCID_PAIRS
            for mode in ["5GEX", "BC", "TCR"]
            for read in ["R1", "R2", "I1", "I2"]
        ],

        # cellranger multi config CSV files
        expand(join(RESULTSDIR, "cellranger", "multi_{library}.csv"), library=LIBRARIES),

        # cellranger raw matrices
        expand(join(RESULTSDIR, "cellranger", "{library}", "outs", "multi", "count", "raw_feature_bc_matrix.h5"), library=LIBRARIES),

        # cellranger web summaries
        expand(join(RESULTSDIR, "cellranger", "{library}.{sample}.web_summary.html"),zip,library=manifest["Library"], sample=manifest["Sample"]),

        # Library-level preprocessing
        expand(join(RESULTSDIR, "preprocessing", "by_library", "{library}.rds"), library=LIBRARIES),

        # Sample-level preprocessing
        expand(join(RESULTSDIR, "preprocessing", "by_sample", "{library}.{sample}.rds"),zip,library=manifest["Library"], sample=manifest["Sample"]),

rule link_fastq:
    """Link and rename fastq files to bcl2fastq format"""
    output:
        fastq = join(RESULTSDIR, "raw", "{library}_{mode}_{fcid}_S1_L001_{read}_001.fastq.gz")
    params:
        library = "{library}",
        mode = "{mode}",
        fcid = "{fcid}",
        read = "{read}"
    shell:
        """
        ln -s {RAWDIR}/Sample_{params.library}_{params.mode}_{params.fcid}/Sample_{params.library}_{params.mode}_{params.fcid}_{params.read}.fastq.gz \
              {RESULTSDIR}/raw/{params.library}_{params.mode}_{params.fcid}_S1_L001_{params.read}_001.fastq.gz
        """

rule make_multi_csv:
    """
    Create a Cell Ranger multi config CSV file
    """
    output:
        multi_csv = join(RESULTSDIR, "cellranger", "multi_{library}.csv")
    params:
        library = "{library}"
    run:
        # Prepare reference section
        reference_lines_gex = [
            "[gene-expression]",
            f"reference,{config['gex_ref']}",
            "create-bam,true",
        ]

        if(config["force"]):
            reference_lines_gex.append(f"force-cells,{config['force_cells']}")

        reference_lines = [
            "",
            "[vdj]",
            f"reference,{config['vdj_ref']}",
            "",
            "[feature]",
            f"reference,{config['feature_ref']}"
        ]
        
        # Prepare libraries section
        libraries_lines = [
            "",
            "[libraries]",
            "fastq_id,fastqs,feature_types"
        ]
        for mode, feature_type in [("5GEX", "Gene Expression"), ("TCR", "VDJ-T"), ("BC", "Antibody Capture")]:
            for fcid in LIBRARY_TO_FCIDS[params.library]:
                fastq_id = f"{params.library}_{mode}_{fcid}"
                fastqs = RESULTSDIR + "/raw"
                libraries_lines.append(f"{fastq_id},{fastqs},{feature_type}")

        # Prepare samples section
        sub = manifest[manifest["Library"] == f"{params.library}"]
        sub = sub.drop_duplicates(subset=["Sample", "Hashtag"])

        print(sub)

        samples_lines = [
            "",
            "[samples]",
            "sample_id,hashtag_ids"
        ]
        for _, row in sub.iterrows():
            samples_lines.append(f"{row['Sample']},{row['Hashtag']}")

        # Write to CSV
        with open(output.multi_csv, "w") as f:
            f.write("\n".join(reference_lines_gex + reference_lines + libraries_lines + samples_lines) + "\n")

rule cellranger:
    """Run Cell Ranger multi for each library"""
    input:
        multi_csv = join(RESULTSDIR,"cellranger","multi_{library}.csv")
    output:
        raw_matrix = join(RESULTSDIR,"cellranger","{library}","outs","multi","count","raw_feature_bc_matrix.h5")
    params:
        library = "{library}",
        outdir = join(RESULTSDIR,"cellranger","{library}")
    envmodules:
        TOOLS["cellranger"]
    shell:
        """
        TEMP=/lscratch/$SLURM_JOB_ID

        rm -r {params.outdir}

        cellranger multi --id {params.library} \
            --csv {input.multi_csv} \
            --output-dir={params.outdir} \
            --localcores=$SLURM_CPUS_PER_TASK \
            --localmem=34 \
            --jobmode=slurm --maxjobs=40
        """

rule copy_summary:
    """Copy and rename Cell Ranger web summary"""
    input:
        raw_matrix = join(RESULTSDIR,"cellranger","{library}","outs","multi","count","raw_feature_bc_matrix.h5")
    output:
        summary = join(RESULTSDIR,"cellranger","{library}.{sample}.web_summary.html")
    params:
        summary = join(RESULTSDIR,"cellranger","{library}","outs","per_sample_outs","{sample}","web_summary.html")
    shell:
        """
        cp {params.summary} {output.summary}
        """

rule preprocess_library:
    """Run library-level demultiplexing, normalization, and QC filtering"""
    input:
        raw_matrix = join(RESULTSDIR,"cellranger","{library}","outs","multi","count","raw_feature_bc_matrix.h5")
    output:
        filtered_obj = join(RESULTSDIR,"preprocessing","by_library","{library}.rds")
    params:
        script = join(SCRIPTSDIR,"preprocessing_library.Rmd"),
        library = "{library}",
        hashtags = lambda wc: HASHTAGS_PER_LIBRARY[wc.library], #"HTO1,HTO2,HTO3,HTO4"
        nFeature_RNA_min = config["nFeature_RNA_min"],
        nFeature_RNA_max = config["nFeature_RNA_max"],
        percent_mt_max = config["percent_mt_max"],
        indir = join(RESULTSDIR,"cellranger"),
        outdir = join(RESULTSDIR,"preprocessing")
    envmodules:
        TOOLS["R"]
    shell:
        """
        Rscript -e 'rmarkdown::render("{params.script}",
                             output_file = "{params.outdir}/by_library/{params.library}.html",
                             params = list(
                                library = "{params.library}",
                                input_dir = "{params.indir}",
                                output_dir = "{params.outdir}",
                                hashtags = "{params.hashtags}",
                                nFeature_RNA_min = {params.nFeature_RNA_min},
                                nFeature_RNA_max = {params.nFeature_RNA_max},
                                percent_mt_max = {params.percent_mt_max}
                             ))'
        """

rule preprocess_sample:
    """Run sample-level normalization and QC filtering"""
    input:
        raw_matrix = join(RESULTSDIR,"cellranger","{library}","outs","multi","count","raw_feature_bc_matrix.h5")
    output:
        filtered_obj = join(RESULTSDIR,"preprocessing","by_sample","{library}.{sample}.rds")
    params:
        script = join(SCRIPTSDIR,"preprocessing_sample.Rmd"),
        library = "{library}",
        sample = "{sample}",
        nFeature_RNA_min = config["nFeature_RNA_min"],
        nFeature_RNA_max = config["nFeature_RNA_max"],
        percent_mt_max = config["percent_mt_max"],
        indir = join(RESULTSDIR,"cellranger"),
        outdir = join(RESULTSDIR,"preprocessing")
    envmodules:
        TOOLS["R"]
    shell:
        """
        Rscript -e 'rmarkdown::render("{params.script}",
                             output_file = "{params.outdir}/by_sample/{params.library}.{params.sample}.html",
                             params = list(
                                library = "{params.library}",
                                sample = "{params.sample}",
                                input_dir = "{params.indir}",
                                output_dir = "{params.outdir}",
                                nFeature_RNA_min = {params.nFeature_RNA_min},
                                nFeature_RNA_max = {params.nFeature_RNA_max},
                                percent_mt_max = {params.percent_mt_max}
                             ))'
        """
